# MoFox Period Plugin 配置文件
# 配置版本 3.1.0 - 支持LLM缓解和自定义概率

[plugin]
enabled = true
config_version = "3.1.0"
debug_mode = false

[cycle]
# 锚点日期：每月固定的日期作为周期计算基准（1-31）
anchor_day = 15

[dysmenorrhea]
# ============================================================================
# 痛经发生概率配置（新功能）
# ============================================================================
# 四个概率值加起来应该等于 1.0（100%）

# 无痛经的概率（0.0-1.0）
prob_none = 0.25

# 轻度痛经的概率（等级1-2，0.0-1.0）
prob_mild = 0.30

# 中度痛经的概率（等级3-4，0.0-1.0）
prob_moderate = 0.25

# 重度痛经的概率（等级5-6，0.0-1.0）
prob_severe = 0.20

# ============================================================================
# LLM智能缓解功能配置（新功能）
# ============================================================================

# 是否启用LLM判定消息缓解痛经功能
enable_llm_relief = true

# 缓解效果持续时间（分钟）
# 建议范围：30-120分钟
relief_duration_minutes = 60

# 缓解时降低的痛经等级（0-6）
# 示例：痛经等级从5降到4（降低1级）
relief_reduction = 1

[levels]
# ============================================================================
# 各阶段影响等级配置
# ============================================================================
# 等级范围：1-10（数值越大影响越强）

# 月经期
menstrual_physical = 5        # 生理影响等级
menstrual_psychological = 4   # 心理影响等级

# 卵泡期
follicular_physical = 2
follicular_psychological = 2

# 排卵期
ovulation_physical = 3
ovulation_psychological = 2

# 黄体期
luteal_physical = 4
luteal_psychological = 3

# ============================================================================
# 配置说明
# ============================================================================
#
# 1. 痛经概率配置示例：
#
#    轻松模式（较少痛经）：
#    prob_none = 0.50, prob_mild = 0.30, prob_moderate = 0.15, prob_severe = 0.05
#
#    真实模式（符合医学统计）：
#    prob_none = 0.25, prob_mild = 0.30, prob_moderate = 0.25, prob_severe = 0.20
#
#    困难模式（较多痛经）：
#    prob_none = 0.10, prob_mild = 0.20, prob_moderate = 0.40, prob_severe = 0.30
#
# 2. LLM缓解功能说明：
#    - 用户发送关心、安慰等消息时，LLM会智能判定是否有缓解作用
#    - 如果有缓解作用，临时降低痛经等级，持续指定时间
#    - 缓解作用的消息示例：
#      ✓ "你还好吗？"、"要不要热敷一下？"、"我理解你的感受"
#      ✗ 普通闲聊、工作讨论等无关消息
#
# 3. 注意事项：
#    - 四个痛经概率的总和必须为 1.0
#    - 修改配置后使用 /regenerate_cycle 重新生成周期
#    - LLM缓解功能需要正确配置MoFox-Bot的LLM API
#
# 4. 查看状态：
#    使用 /period 命令查看当前周期状态和痛经等级
#
# 5. 更多信息：
#    详细使用说明请查看 NEW_FEATURES.md 文档
#
# ============================================================================
